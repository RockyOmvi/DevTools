  },
  "tools/diff-checker.html": {
    "workspace": "\n        <div class=\"diff-container\">\n          <div class=\"diff-box\">\n            <label for=\"originalText\" style=\"font-weight: 600; font-size: 0.85rem; margin-bottom: 0.35rem; color: var(--text-secondary);\">Original Text (Left Pane)</label>\n            <textarea id=\"originalText\" class=\"code-textarea\" placeholder=\"Paste original text here...\" style=\"min-height: 180px;\"></textarea>\n          </div>\n          <div class=\"diff-box\">\n            <label for=\"modifiedText\" style=\"font-weight: 600; font-size: 0.85rem; margin-bottom: 0.35rem; color: var(--text-secondary);\">Modified Text (Right Pane)</label>\n            <textarea id=\"modifiedText\" class=\"code-textarea\" placeholder=\"Paste modified text here...\" style=\"min-height: 180px;\"></textarea>\n          </div>\n        </div>\n\n        <div class=\"workspace-actions\" style=\"margin-bottom: 1.5rem;\">\n          <button class=\"btn btn-primary\" id=\"compareBtn\">Compare Diffs</button>\n          <button class=\"btn btn-secondary\" id=\"loadSampleBtn\">Load Sample Code</button>\n          <button class=\"btn btn-danger\" id=\"clearBtn\">Clear</button>\n        </div>\n\n        <div class=\"error-message\" id=\"errorMessage\"></div>\n\n        <div class=\"diff-result-wrapper\">\n          <div class=\"diff-output\" id=\"diffOutput\" style=\"display: none;\">\n            <div class=\"diff-pane\" id=\"diffLeft\" style=\"border-right: 1px solid var(--border); padding-right: 0.5rem;\"></div>\n            <div class=\"diff-pane\" id=\"diffRight\" style=\"padding-left: 0.5rem;\"></div>\n          </div>\n        </div>\n      ",
    "script": "diff-checker.js",
    "relatedTools": "\n        <li><a href=\"/tools/json-validator.html\">JSON Validator</a></li>\n        <li><a href=\"/tools/regex-tester.html\">Regex Tester</a></li>\n      "
  },
  "tools/api-tester.html": {
    "workspace": "\n        <div class=\"api-tester-grid\">\n          <div class=\"api-request-bar\">\n            <select id=\"apiMethod\" class=\"form-control api-method-select\">\n              <option value=\"GET\">GET</option>\n              <option value=\"POST\">POST</option>\n              <option value=\"PUT\">PUT</option>\n              <option value=\"DELETE\">DELETE</option>\n              <option value=\"PATCH\">PATCH</option>\n              <option value=\"OPTIONS\">OPTIONS</option>\n            </select>\n            <input type=\"text\" id=\"apiUrl\" class=\"form-control\" placeholder=\"https://jsonplaceholder.typicode.com/posts/1\" style=\"flex: 1;\">\n            <button class=\"btn btn-primary\" id=\"sendRequestBtn\" style=\"padding: 0.6rem 1.5rem;\">Send</button>\n          </div>\n\n          <div style=\"display: flex; gap: 1rem; align-items: center; margin-bottom: 0.5rem;\">\n            <label style=\"display: flex; align-items: center; gap: 0.4rem; font-weight: 600; font-size: 0.85rem; cursor: pointer; color: var(--text-secondary);\">\n              <input type=\"checkbox\" id=\"mockMode\"> Use Mock Response\n            </label>\n          </div>\n\n          <div class=\"api-tabs\">\n            <button class=\"api-tab-btn active\" id=\"tabHeaders\">Headers</button>\n            <button class=\"api-tab-btn\" id=\"tabBody\">Body</button>\n          </div>\n\n          <!-- Pane: Headers -->\n          <div class=\"api-tab-content active\" id=\"paneHeaders\">\n            <div id=\"headersList\" class=\"api-headers-list\" style=\"margin-bottom: 0.75rem;\">\n              <!-- Dynamic Rows -->\n            </div>\n            <button type=\"button\" class=\"btn btn-secondary\" id=\"addHeaderBtn\">+ Add Request Header</button>\n          </div>\n\n          <!-- Pane: Body -->\n          <div class=\"api-tab-content\" id=\"paneBody\">\n            <textarea id=\"requestBody\" class=\"code-textarea\" placeholder=\"{\\n  \\\"key\\\": \\\"value\\\"\\n}\" disabled style=\"min-height: 150px;\"></textarea>\n          </div>\n\n          <div class=\"workspace-actions\" style=\"margin-top: 1rem;\">\n            <button class=\"btn btn-danger\" id=\"clearBtn\">Clear Fields</button>\n          </div>\n        </div>\n\n        <div class=\"error-message\" id=\"errorMessage\" style=\"margin-top: 1rem;\"></div>\n\n        <!-- Response Container -->\n        <div id=\"responseWrapper\" style=\"display: none; margin-top: 1.5rem;\">\n          <h4 style=\"margin-bottom: 0.5rem;\">Response Summary</h4>\n          <div style=\"display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;\">\n            <span id=\"responseStatus\" style=\"padding: 0.35rem 0.75rem; border-radius: var(--radius-sm); font-weight: 700; font-size: 0.85rem;\">200 OK</span>\n            <span id=\"responseTime\" style=\"font-size: 0.85rem; color: var(--text-muted);\">Time: 0 ms</span>\n          </div>\n\n          <div class=\"diff-container\">\n            <div class=\"diff-box\">\n              <h5 style=\"margin-bottom: 0.5rem; color: var(--text-secondary);\">Response Headers</h5>\n              <pre id=\"responseHeaders\" style=\"background-color: var(--bg-tertiary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.75rem; font-family: var(--font-mono); font-size: 0.8rem; min-height: 120px; overflow-y: auto; max-height: 250px; white-space: pre-wrap; word-break: break-all;\"></pre>\n            </div>\n            <div class=\"diff-box\">\n              <h5 style=\"margin-bottom: 0.5rem; color: var(--text-secondary);\">Response Body</h5>\n              <pre id=\"responseBody\" style=\"background-color: var(--bg-tertiary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.75rem; font-family: var(--font-mono); font-size: 0.8rem; min-height: 120px; overflow-y: auto; max-height: 250px; white-space: pre-wrap; word-break: break-all;\"></pre>\n            </div>\n          </div>\n        </div>\n      ",
    "script": "api-tester.js",
    "relatedTools": "\n        <li><a href=\"/tools/json-validator.html\">JSON Validator</a></li>\n        <li><a href=\"/tools/jwt-decoder.html\">JWT Decoder</a></li>\n      "
  },
  "tools/epoch-converter.html": {
    "workspace": "\n        <div class=\"api-tester-grid\" style=\"margin-bottom: 1.5rem;\">\n          <div style=\"background: var(--bg-tertiary); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.75rem;\">\n            <div style=\"display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;\">\n              <span style=\"font-weight: 600; color: var(--text-secondary);\">Current Unix Epoch (Seconds):</span>\n              <div style=\"display: flex; align-items: center; gap: 0.75rem;\">\n                <span id=\"currentEpochSeconds\" style=\"font-family: var(--font-mono); font-size: 1.3rem; font-weight: 700; color: var(--accent);\"></span>\n                <button class=\"btn btn-secondary\" id=\"copySecondsBtn\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button>\n              </div>\n            </div>\n            <div style=\"display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;\">\n              <span style=\"font-weight: 600; color: var(--text-secondary);\">Current Unix Epoch (Milliseconds):</span>\n              <div style=\"display: flex; align-items: center; gap: 0.75rem;\">\n                <span id=\"currentEpochMillis\" style=\"font-family: var(--font-mono); font-size: 1.1rem; font-weight: 600;\"></span>\n                <button class=\"btn btn-secondary\" id=\"copyMillisBtn\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Section 1: Timestamp to Date -->\n        <div style=\"margin-bottom: 2rem;\">\n          <h3 style=\"margin-bottom: 0.5rem;\">1. Convert Unix Timestamp to Human Date</h3>\n          <div class=\"form-group\">\n            <label for=\"tsInput\">Enter Unix Timestamp (Seconds or Milliseconds):</label>\n            <div style=\"display: flex; gap: 0.5rem; flex-wrap: wrap;\">\n              <input type=\"text\" id=\"tsInput\" class=\"form-control\" placeholder=\"e.g. 1760460000 or 1760460000000\" style=\"font-family: var(--font-mono); flex: 1;\">\n              <button class=\"btn btn-primary\" id=\"convertTsBtn\">Convert Timestamp</button>\n              <button class=\"btn btn-secondary\" id=\"setNowBtn\">Current Time</button>\n              <button class=\"btn btn-danger\" id=\"clearTsBtn\">Clear</button>\n            </div>\n          </div>\n\n          <div class=\"error-message\" id=\"tsError\"></div>\n\n          <div id=\"tsResultContainer\" style=\"display: none; margin-top: 1rem;\">\n            <div class=\"content-table-wrapper\">\n              <table class=\"content-table\">\n                <thead>\n                  <tr>\n                    <th style=\"width: 25%;\">Time Format</th>\n                    <th>Parsed Value</th>\n                    <th style=\"width: 15%;\">Action</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td><strong>GMT / UTC</strong></td>\n                    <td id=\"outUtc\" style=\"font-family: var(--font-mono);\"></td>\n                    <td><button class=\"btn btn-secondary\" data-copy-id=\"outUtc\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button></td>\n                  </tr>\n                  <tr>\n                    <td><strong>Your Local Timezone</strong></td>\n                    <td id=\"outLocal\" style=\"font-family: var(--font-mono);\"></td>\n                    <td><button class=\"btn btn-secondary\" data-copy-id=\"outLocal\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button></td>\n                  </tr>\n                  <tr>\n                    <td><strong>ISO 8601 Standard</strong></td>\n                    <td id=\"outIso\" style=\"font-family: var(--font-mono);\"></td>\n                    <td><button class=\"btn btn-secondary\" data-copy-id=\"outIso\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button></td>\n                  </tr>\n                  <tr>\n                    <td><strong>RFC 2822</strong></td>\n                    <td id=\"outRfc\" style=\"font-family: var(--font-mono);\"></td>\n                    <td><button class=\"btn btn-secondary\" data-copy-id=\"outRfc\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button></td>\n                  </tr>\n                  <tr>\n                    <td><strong>Relative Time</strong></td>\n                    <td id=\"outRelative\" style=\"font-weight: 500; color: var(--accent);\"></td>\n                    <td></td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n\n        <!-- Section 2: Date to Timestamp -->\n        <div style=\"margin-bottom: 1.5rem;\">\n          <h3 style=\"margin-bottom: 0.5rem;\">2. Convert Human Date to Unix Timestamp</h3>\n          <div class=\"form-group\">\n            <label for=\"dateInput\">Enter Date & Time string or ISO format:</label>\n            <div style=\"display: flex; gap: 0.5rem; flex-wrap: wrap;\">\n              <input type=\"datetime-local\" id=\"dateInput\" class=\"form-control\" style=\"font-family: var(--font-mono); flex: 1;\">\n              <button class=\"btn btn-primary\" id=\"convertDateBtn\">Convert Date</button>\n              <button class=\"btn btn-secondary\" id=\"setDateNowBtn\">Set Now</button>\n            </div>\n          </div>\n\n          <div class=\"error-message\" id=\"dateError\"></div>\n\n          <div id=\"dateResultContainer\" style=\"display: none; margin-top: 1rem;\">\n            <div class=\"diff-container\">\n              <div class=\"diff-box\">\n                <label style=\"font-weight: 600; font-size: 0.85rem; color: var(--text-secondary);\">Epoch Seconds</label>\n                <div style=\"display: flex; align-items: center; justify-content: space-between; background: var(--bg-tertiary); padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border);\">\n                  <span id=\"outDateSeconds\" style=\"font-family: var(--font-mono); font-size: 1.1rem; font-weight: 600;\"></span>\n                  <button class=\"btn btn-secondary\" data-copy-id=\"outDateSeconds\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button>\n                </div>\n              </div>\n              <div class=\"diff-box\">\n                <label style=\"font-weight: 600; font-size: 0.85rem; color: var(--text-secondary);\">Epoch Milliseconds</label>\n                <div style=\"display: flex; align-items: center; justify-content: space-between; background: var(--bg-tertiary); padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border);\">\n                  <span id=\"outDateMillis\" style=\"font-family: var(--font-mono); font-size: 1.1rem; font-weight: 600;\"></span>\n                  <button class=\"btn btn-secondary\" data-copy-id=\"outDateMillis\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      ",
    "script": "epoch-converter.js",
    "relatedTools": "\n        <li><a href=\"/tools/cron-generator.html\">Cron Generator</a></li>\n        <li><a href=\"/tools/uuid-generator.html\">UUID Generator</a></li>\n        <li><a href=\"/tools/api-tester.html\">API Tester</a></li>\n      "
  },
  "tools/base64-tools.html": {
    "workspace": "\n        <div class=\"api-tabs\" style=\"margin-bottom: 1rem;\">\n          <button class=\"api-tab-btn active\" id=\"tabText\">Base64 Text Converter</button>\n          <button class=\"api-tab-btn\" id=\"tabImage\">Base64 Image / File Converter</button>\n        </div>\n\n        <!-- Pane: Text Mode -->\n        <div id=\"paneText\">\n          <div class=\"form-group\">\n            <label for=\"textInput\">Input Text String to Encode / Decode:</label>\n            <textarea id=\"textInput\" class=\"code-textarea\" placeholder=\"Type or paste text string here... (UTF-8 and Emojis supported)\"></textarea>\n          </div>\n\n          <div class=\"workspace-actions\" style=\"margin-bottom: 1rem; justify-content: space-between; align-items: center;\">\n            <div style=\"display: flex; gap: 0.5rem;\">\n              <button class=\"btn btn-primary\" id=\"encodeBtn\">Encode to Base64</button>\n              <button class=\"btn btn-success\" id=\"decodeBtn\">Decode from Base64</button>\n              <button class=\"btn btn-danger\" id=\"clearTextBtn\">Clear</button>\n            </div>\n            <label style=\"display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 500; cursor: pointer;\">\n              <input type=\"checkbox\" id=\"urlSafeToggle\"> URL-Safe Base64 (- and _)\n            </label>\n          </div>\n\n          <div class=\"error-message\" id=\"textError\"></div>\n\n          <div class=\"output-container\">\n            <div class=\"output-header\">\n              <span>Base64 Text Result</span>\n              <button class=\"btn btn-secondary\" id=\"copyTextOutputBtn\" style=\"padding: 0.25rem 0.5rem; font-size: 0.75rem;\">Copy Result</button>\n            </div>\n            <div class=\"output-body\" id=\"textOutput\" style=\"min-height: 100px; word-break: break-all;\"></div>\n          </div>\n        </div>\n\n        <!-- Pane: Image Mode -->\n        <div id=\"paneImage\" style=\"display: none;\">\n          <div id=\"dropZone\" style=\"border: 2px dashed var(--border); border-radius: var(--radius-md); padding: 2rem; text-align: center; cursor: pointer; margin-bottom: 1rem; transition: border-color 0.2s;\">\n            <svg viewBox=\"0 0 24 24\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" style=\"color: var(--accent); margin-bottom: 0.5rem;\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12\"/></svg>\n            <p style=\"margin-bottom: 0.5rem; font-weight: 600;\">Drag & Drop Image or File here</p>\n            <p style=\"font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;\">Supports PNG, JPG, WEBP, SVG, GIF, PDF (Max 10 MB)</p>\n            <input type=\"file\" id=\"fileInput\" style=\"display: none;\">\n            <button class=\"btn btn-secondary\" onclick=\"document.getElementById('fileInput').click()\">Browse Computer</button>\n          </div>\n\n          <div class=\"error-message\" id=\"imageError\"></div>\n\n          <div id=\"imageResultContainer\" style=\"display: none;\">\n            <div id=\"imageInfo\" style=\"background: var(--bg-tertiary); padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border); margin-bottom: 1rem; font-size: 0.9rem;\"></div>\n\n            <div style=\"display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem;\">\n              <div style=\"flex: 1; min-width: 200px; text-align: center; background: var(--bg-secondary); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border);\">\n                <h5 style=\"margin-bottom: 0.75rem; color: var(--text-secondary);\">Live Image Preview</h5>\n                <img id=\"imagePreview\" src=\"\" alt=\"Base64 Image Preview\" style=\"max-width: 100%; max-height: 200px; object-fit: contain; border-radius: var(--radius-sm);\">\n              </div>\n            </div>\n\n            <div class=\"workspace-actions\" style=\"margin-bottom: 1rem; gap: 0.5rem;\">\n              <button class=\"btn btn-primary\" id=\"copyDataUrlBtn\">Copy Data URL</button>\n              <button class=\"btn btn-secondary\" id=\"copyRawB64Btn\">Copy Raw Base64</button>\n              <button class=\"btn btn-secondary\" id=\"copyImgTagBtn\">Copy &lt;img&gt; Tag</button>\n              <button class=\"btn btn-secondary\" id=\"copyCssBgBtn\">Copy CSS Background</button>\n            </div>\n\n            <div class=\"output-container\">\n              <div class=\"output-header\">\n                <span>Data URL String (Base64)</span>\n              </div>\n              <div class=\"output-body\" id=\"dataUrlOutput\" style=\"max-height: 150px; overflow-y: auto; font-size: 0.8rem; word-break: break-all;\"></div>\n            </div>\n\n            <div class=\"output-container\" style=\"margin-top: 1rem;\">\n              <div class=\"output-header\">\n                <span>Raw Base64 String</span>\n              </div>\n              <div class=\"output-body\" id=\"rawBase64Output\" style=\"max-height: 150px; overflow-y: auto; font-size: 0.8rem; word-break: break-all;\"></div>\n            </div>\n          </div>\n        </div>\n      ",
    "script": "base64-tools.js",
    "relatedTools": "\n        <li><a href=\"/tools/url-encoder.html\">URL Encoder</a></li>\n        <li><a href=\"/tools/url-decoder.html\">URL Decoder</a></li>\n        <li><a href=\"/tools/hash-generator.html\">Hash Generator</a></li>\n      "
  },
  "tools/json-to-types.html": {
    "workspace": "\n        <div class=\"diff-container\" style=\"margin-bottom: 1rem;\">\n          <div class=\"diff-box\">\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;\">\n              <label for=\"jsonInput\" style=\"font-weight: 600; font-size: 0.85rem; color: var(--text-secondary);\">Input JSON Data</label>\n              <div style=\"display: flex; gap: 0.35rem;\">\n                <button class=\"btn btn-secondary\" id=\"sampleUserBtn\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">User Sample</button>\n                <button class=\"btn btn-secondary\" id=\"sampleOrderBtn\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Order Sample</button>\n              </div>\n            </div>\n            <textarea id=\"jsonInput\" class=\"code-textarea\" placeholder=\"Paste raw JSON object or array here...\" style=\"min-height: 320px;\"></textarea>\n          </div>\n          <div class=\"diff-box\">\n            <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;\">\n              <label for=\"outputCode\" style=\"font-weight: 600; font-size: 0.85rem; color: var(--text-secondary);\">Generated Type Definitions</label>\n              <div style=\"display: flex; gap: 0.35rem;\">\n                <button class=\"btn btn-secondary\" id=\"copyBtn\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Copy</button>\n                <button class=\"btn btn-secondary\" id=\"downloadBtn\" style=\"padding: 0.2rem 0.5rem; font-size: 0.75rem;\">Download</button>\n              </div>\n            </div>\n            <pre id=\"outputCode\" class=\"code-textarea\" style=\"min-height: 320px; white-space: pre; overflow-x: auto; background: var(--bg-tertiary); font-family: var(--font-mono); font-size: 0.85rem; margin: 0;\"></pre>\n          </div>\n        </div>\n\n        <div class=\"workspace-actions\" style=\"justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;\">\n          <div style=\"display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;\">\n            <div style=\"display: flex; align-items: center; gap: 0.5rem;\">\n              <label for=\"targetLang\" style=\"font-size: 0.85rem; font-weight: 600;\">Target:</label>\n              <select id=\"targetLang\" class=\"form-control\" style=\"width: auto;\">\n                <option value=\"typescript\">TypeScript Interfaces</option>\n                <option value=\"go\">Go Structs (with JSON tags)</option>\n              </select>\n            </div>\n            <div style=\"display: flex; align-items: center; gap: 0.5rem;\">\n              <label for=\"rootNameInput\" style=\"font-size: 0.85rem; font-weight: 600;\">Root Name:</label>\n              <input type=\"text\" id=\"rootNameInput\" class=\"form-control\" value=\"RootObject\" style=\"width: 140px;\">\n            </div>\n          </div>\n          <div style=\"display: flex; gap: 0.5rem;\">\n            <button class=\"btn btn-primary\" id=\"generateBtn\">Convert to Types</button>\n            <button class=\"btn btn-danger\" id=\"clearBtn\">Clear</button>\n          </div>\n        </div>\n\n        <div class=\"error-message\" id=\"errorMessage\"></div>\n      ",
    "script": "json-to-types.js",
    "relatedTools": "\n        <li><a href=\"/tools/json-validator.html\">JSON Validator</a></li>\n        <li><a href=\"/tools/diff-checker.html\">Diff Checker</a></li>\n        <li><a href=\"/tools/api-tester.html\">API Tester</a></li>\n      "
  }
